{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cz-harness/schemas/rd.schema.json",
  "title": "Requirement Detail (RD)",
  "description": "One YAML file per RD under rd/. content_hash covers ONLY statement + ac[] + nfr_refs (plan §4.2).",
  "type": "object",
  "required": ["id", "version", "content_hash", "parent_req", "wbs", "module", "layer", "statement", "ac", "hazard", "delegation", "estimate", "red_skipped", "state"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^RD-[A-Za-z0-9]+-[0-9]+\\.[0-9]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" },
    "parent_req": { "type": "string", "pattern": "^REQ-[A-Za-z0-9]+-[0-9]+$" },
    "wbs": { "type": "string", "pattern": "^WBS-[A-Za-z0-9]+-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "module": { "type": "string" },
    "layer": { "type": "integer", "enum": [0, 1] },
    "statement": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "maxLength": 120, "description": "One-line, human-scannable gloss of the statement — shown as the board's RD-table Summary column. Optional but expected on every RD from /cz:rd onward; not covered by content_hash." },
    "ac": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[A-Za-z0-9]+-[0-9]+\\.[0-9]+-[0-9]+$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "nfr_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^NFR-[A-Za-z0-9]+-[0-9]+$" }
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^RD-[A-Za-z0-9]+-[0-9]+\\.[0-9]+$" }
    },
    "hazard": { "type": "boolean" },
    "priority": { "type": "string", "enum": ["low", "medium", "high"], "description": "Operational metadata, not covered by content_hash (docs/TRACEABILITY.md). Optional — absent/omitted is treated as \"medium\" by hooks/project-state.sh's board projection." },
    "delegation": {
      "type": "object",
      "required": ["level", "leash"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "leash": { "type": "string", "enum": ["A", "A+"] }
      }
    },
    "estimate": {
      "type": "object",
      "required": ["optimistic", "likely", "pessimistic", "expected_h"],
      "additionalProperties": false,
      "properties": {
        "optimistic": { "type": "number", "minimum": 0 },
        "likely": { "type": "number", "minimum": 0 },
        "pessimistic": { "type": "number", "minimum": 0, "maximum": 6 },
        "expected_h": { "type": "number", "minimum": 0, "maximum": 4 }
      }
    },
    "red_skipped": { "type": "boolean", "description": "Permanent once true. Only ever true under profile: light AND layer: 1." },
    "state": {
      "type": "string",
      "enum": ["draft", "blocked_dep", "ready", "claimed", "red", "green", "ai_review", "sec_review", "human_review", "accepted", "rejected", "stale", "blocked_hardstop", "withdrawn"]
    },
    "assigned_agent": { "type": ["string", "null"] },
    "claimed_at": { "type": ["string", "null"], "format": "date-time" },
    "tests": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TC-[A-Za-z0-9]+-[0-9]+\\.[0-9]+-[0-9]+[NPF]?$" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "red_log": { "type": ["string", "null"] },
        "green_log": { "type": ["string", "null"] }
      }
    },
    "gates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^GATE-RD-[A-Za-z0-9]+-[0-9]+\\.[0-9]+-[0-9]+$" }
    }
  },
  "allOf": [
    {
      "description": "Six-way RD validity rule (plan §4.1): AC count 1-3, sizing bounds, one module, no cross-module AC — enforced in full by /cz:rd, this schema only checks the structurally-representable parts.",
      "properties": {
        "ac": { "minItems": 1, "maxItems": 3 }
      }
    }
  ]
}
